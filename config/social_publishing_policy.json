  "timezone": "Asia/Bangkok",
  "activePublisher": "zapier-to-buffer",
  "otherPublishers": {
    "metricool": {
      "mayPublish": false,
      "reason": "No confirmed food brand connection"
    },
    "github_buffer_direct": {
      "mayPublish": false,
      "reason": "Manual-only diagnostic failed 401; avoid duplicating Zapier"
    }
  },
  "postingSlots": {
    "buffer": [
      "18:30"
    ]
