    "requireLiveCanonicalUrl": true,
    "doNotScheduleDrafts": true,
    "doNotPublishUnverifiedRestaurantInfo": true,
    "avoidSubstantiallySimilarText": true,
    "doNotRecycleOnError": true,
    "reviewExistingPendingPostsBeforeEnqueue": true,
    "doNotCrossPostToPcPage": true
  },
  "dedupeKeyFields": [
    "facebook_page_id",
    "canonical_url",
    "article_id",
    "normalized_content_hash"
  ],
  "status": "Policy only. Does not enable or disable a live integration without the publishing service adopting it."
}
